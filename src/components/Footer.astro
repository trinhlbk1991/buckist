---
import { footerLeftLinks, footerRightLinks } from '../data/footer';
---
<footer>
  <div class="container">
    <ul class="footer-left-links">
      {footerLeftLinks.map((link) => (
        <li><a href={link.link}>{link.name}</a></li>
      ))}
    </ul>

    <ul class="footer-right-links">
      {footerRightLinks.map((link) => (
        <li>
          <a
            href={link.link}
            class={`${link.icon}-icon`}
            target={link.newWindow ? '_blank' : undefined}
            rel={link.newWindow ? 'noopener noreferrer' : undefined}
          >
            {link.icon === 'facebook' && (
              <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M18.05.811q.439 0 .744.305t.305.744v16.637q0 .439-.305.744t-.744.305h-4.732v-7.221h2.415l.342-2.854h-2.757v-1.83q0-.659.293-1t1.073-.342h1.488V3.762q-.976-.098-2.171-.098-1.634 0-2.635.964t-1 2.72V9.47H7.951v2.854h2.415v7.221H1.413q-.439 0-.744-.305t-.305-.744V1.86q0-.439.305-.744T1.413.811H18.05z"/></svg>
            )}
            {link.icon === 'youtube' && (
              <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M9.426 14.597l5.399-3.199-5.399-3.398v6.597zM19.588 5.177s-.193-1.378-.789-1.983c-.756-.798-1.6-.802-1.987-.848C13.83 2.102 9.688 2.1 9.688 2.1h-.008s-4.143.002-7.126.246c-.387.046-1.23.05-1.986.848-.596.605-.789 1.983-.789 1.983S-.425 6.775-.425 8.373v1.499c0 1.598.204 3.196.204 3.196s.193 1.378.789 1.984c.756.797 1.749.771 2.19.855C4.347 16.073 9.684 16.12 9.684 16.12s4.146-.007 7.128-.25c.387-.047 1.231-.051 1.987-.849.596-.605.789-1.984.789-1.984s.204-1.598.204-3.196V8.342c0-1.598-.204-3.165-.204-3.165z"/></svg>
            )}
            {link.icon === 'instagram' && (
              <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M14.93 1.613H4.614C2.95 1.613 1.6 2.963 1.6 4.627v10.316c0 1.664 1.35 3.014 3.014 3.014H14.93c1.664 0 3.014-1.35 3.014-3.014V4.627c0-1.664-1.35-3.014-3.014-3.014zm-4.958 13.3c-2.837 0-5.142-2.305-5.142-5.142 0-2.837 2.305-5.142 5.142-5.142 2.837 0 5.142 2.305 5.142 5.142 0 2.837-2.305 5.142-5.142 5.142zm5.352-9.266c-.664 0-1.203-.539-1.203-1.203s.539-1.203 1.203-1.203 1.203.539 1.203 1.203-.539 1.203-1.203 1.203zM9.972 7.058c-1.853 0-3.355 1.503-3.355 3.355s1.503 3.355 3.355 3.355c1.853 0 3.355-1.503 3.355-3.355S11.825 7.058 9.972 7.058z"/></svg>
            )}
            {link.icon === 'rss' && (
              <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M2.252 17.373c0 .975-.79 1.764-1.764 1.764S-1.276 18.348-1.276 17.373s.79-1.764 1.764-1.764 1.764.79 1.764 1.764zM-1.276 7.885v3.502c5.814 0 7.088 5.235 7.088 7.088h3.502c0-5.85-4.741-10.59-10.59-10.59zM-1.276.988v3.502C7.987 4.49 15.017 11.52 15.017 20.783h3.502C18.519 9.585 8.922-.012-1.276.988z"/></svg>
            )}
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <p class="copyright">&copy; {new Date().getFullYear()} Buckist. All rights reserved.</p>
  </div>
</footer>
